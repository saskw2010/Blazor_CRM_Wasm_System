{
  "components": [
    {
      "type": "content",
      "container": "main",
      "components": [
        {
          "components": [
            {
              "class": "col-md-9",
              "components": [
                {
                  "name": "closeLabel",
                  "style": {
                    "fontWeight": "bold"
                  },
                  "text": "Item no longer available.",
                  "type": "label",
                  "visible": "${!canEdit}"
                }
              ],
              "name": "col0",
              "type": "col"
            },
            {
              "class": "col-md-3",
              "components": [
                {
                  "buttonStyle": "secondary",
                  "events": {
                    "click": [
                      {
                        "type": "close-popup"
                      }
                    ]
                  },
                  "icon": "",
                  "name": "closeButton",
                  "style": {
                    "marginBottom": "20px"
                  },
                  "text": "Close",
                  "type": "button",
                  "visible": "${!canEdit}"
                }
              ],
              "name": "col1",
              "type": "col"
            }
          ],
          "name": "row0",
          "style": {},
          "type": "row"
        },
        {
          "components": [
            {
              "class": "col-md-9",
              "components": [
                {
                  "name": "label0",
                  "style": {
                    "fontWeight": "bold"
                  },
                  "text": "Another user has made conflicting changes to one or more of the fields you have modified. Please reload.",
                  "type": "label",
                  "visible": "${hasChanges}"
                }
              ],
              "name": "col0",
              "type": "col"
            },
            {
              "class": "col-md-3",
              "components": [
                {
                  "buttonStyle": "secondary",
                  "events": {
                    "click": [
                      {
                        "code": "await this.Load()",
                        "type": "execute"
                      }
                    ]
                  },
                  "icon": "autorenew",
                  "name": "button0",
                  "style": {
                    "marginBottom": "20px"
                  },
                  "text": "Reload",
                  "type": "button",
                  "visible": "${hasChanges}"
                }
              ],
              "name": "col1",
              "type": "col"
            }
          ],
          "name": "row0",
          "style": {},
          "type": "row"
        },
        {
          "type": "row",
          "components": [
            {
              "type": "col",
              "class": "col-md-12",
              "components": [
                {
                  "type": "template-form",
                  "name": "form0",
                  "components": [
                    {
                      "type": "row",
                      "style": {
                        "marginBottom": "1rem"
                      },
                      "components": [
                        {
                          "type": "col",
                          "class": "col-md-3",
                          "components": [
                            {
                              "type": "label",
                              "text": "Amount",
                              "component": "Amount",
                              "name": "AmountLabel",
                              "style": {
                                "width": "100%"
                              }
                            }
                          ]
                        },
                        {
                          "type": "col",
                          "class": "col-md-9",
                          "components": [
                            {
                              "valueType": "decimal",
                              "type": "numeric",
                              "name": "Amount",
                              "style": {
                                "display": "block",
                                "width": "100%"
                              },
                              "value": "${opportunity.Amount}"
                            },
                            {
                              "type": "required-validator",
                              "name": "AmountRequiredValidator",
                              "component": "Amount",
                              "text": "Amount is required",
                              "style": {
                                "position": "absolute"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "style": {
                        "marginBottom": "1rem"
                      },
                      "components": [
                        {
                          "type": "col",
                          "class": "col-md-3",
                          "components": [
                            {
                              "type": "label",
                              "text": "User Id",
                              "component": "UserId",
                              "name": "UserIdLabel",
                              "style": {
                                "width": "100%"
                              }
                            }
                          ]
                        },
                        {
                          "type": "col",
                          "class": "col-md-9",
                          "components": [
                            {
                              "valueType": "string",
                              "maxLength": 450,
                              "type": "textbox",
                              "name": "UserId",
                              "style": {
                                "display": "block",
                                "width": "100%"
                              },
                              "value": "${opportunity.UserId}"
                            },
                            {
                              "type": "required-validator",
                              "name": "UserIdRequiredValidator",
                              "component": "UserId",
                              "text": "UserId is required",
                              "style": {
                                "position": "absolute"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "style": {
                        "marginBottom": "1rem"
                      },
                      "components": [
                        {
                          "type": "col",
                          "class": "col-md-3",
                          "components": [
                            {
                              "type": "label",
                              "text": "Contact",
                              "component": "ContactId",
                              "name": "ContactIdLabel",
                              "style": {
                                "width": "100%"
                              }
                            }
                          ]
                        },
                        {
                          "type": "col",
                          "class": "col-md-9",
                          "components": [
                            {
                              "data": "${getContactsForContactIdResult}",
                              "textProperty": "Email",
                              "valueProperty": "Id",
                              "placeholder": "Choose Contact",
                              "valueType": "int",
                              "showSearch": false,
                              "count": "${getContactsForContactIdCount}",
                              "value": "${opportunity.ContactId}",
                              "type": "dropdown-datagrid",
                              "name": "ContactId",
                              "style": {
                                "display": "block",
                                "width": "100%"
                              },
                              "selectedValue": "${getByContactsForContactIdResult}",
                              "events": {
                                "loadData": [
                                  {
                                    "name": "CRM.getContacts",
                                    "parameters": [
                                      {
                                        "name": "$top",
                                        "value": "${event.top}"
                                      },
                                      {
                                        "name": "$skip",
                                        "value": "${event.skip}"
                                      },
                                      {
                                        "name": "$orderby",
                                        "value": "${event.orderby}"
                                      },
                                      {
                                        "name": "$filter",
                                        "value": "contains(Email, '{(!string.IsNullOrEmpty(args.Filter) ? args.Filter : \"\")}')"
                                      },
                                      {
                                        "name": "$count",
                                        "value": "true"
                                      }
                                    ],
                                    "then": [
                                      {
                                        "name": "getContactsForContactIdResult",
                                        "type": "set",
                                        "value": "${result.Value.AsODataEnumerable()}",
                                        "valueType": "IEnumerable<BlazorCrmWasm.Models.Crm.Contact>"
                                      },
                                      {
                                        "name": "getContactsForContactIdCount",
                                        "type": "set",
                                        "value": "result.Count"
                                      }
                                    ],
                                    "type": "invoke"
                                  }
                                ]
                              }
                            },
                            {
                              "type": "required-validator",
                              "name": "ContactIdRequiredValidator",
                              "component": "ContactId",
                              "text": "ContactId is required",
                              "style": {
                                "position": "absolute"
                              },
                              "defaultValue": "0"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "style": {
                        "marginBottom": "1rem"
                      },
                      "components": [
                        {
                          "type": "col",
                          "class": "col-md-3",
                          "components": [
                            {
                              "type": "label",
                              "text": "Opportunity Status",
                              "component": "StatusId",
                              "name": "StatusIdLabel",
                              "style": {
                                "width": "100%"
                              }
                            }
                          ]
                        },
                        {
                          "type": "col",
                          "class": "col-md-9",
                          "components": [
                            {
                              "data": "${getOpportunityStatusesForStatusIdResult}",
                              "textProperty": "Name",
                              "valueProperty": "Id",
                              "placeholder": "Choose OpportunityStatus",
                              "valueType": "int",
                              "showSearch": false,
                              "count": "${getOpportunityStatusesForStatusIdCount}",
                              "value": "${opportunity.StatusId}",
                              "type": "dropdown-datagrid",
                              "name": "StatusId",
                              "style": {
                                "display": "block",
                                "width": "100%"
                              },
                              "selectedValue": "${getByOpportunityStatusesForStatusIdResult}",
                              "events": {
                                "loadData": [
                                  {
                                    "name": "CRM.getOpportunityStatuses",
                                    "parameters": [
                                      {
                                        "name": "$top",
                                        "value": "${event.top}"
                                      },
                                      {
                                        "name": "$skip",
                                        "value": "${event.skip}"
                                      },
                                      {
                                        "name": "$orderby",
                                        "value": "${event.orderby}"
                                      },
                                      {
                                        "name": "$filter",
                                        "value": "contains(Name, '{(!string.IsNullOrEmpty(args.Filter) ? args.Filter : \"\")}')"
                                      },
                                      {
                                        "name": "$count",
                                        "value": "true"
                                      }
                                    ],
                                    "then": [
                                      {
                                        "name": "getOpportunityStatusesForStatusIdResult",
                                        "type": "set",
                                        "value": "${result.Value.AsODataEnumerable()}",
                                        "valueType": "IEnumerable<BlazorCrmWasm.Models.Crm.OpportunityStatus>"
                                      },
                                      {
                                        "name": "getOpportunityStatusesForStatusIdCount",
                                        "type": "set",
                                        "value": "result.Count"
                                      }
                                    ],
                                    "type": "invoke"
                                  }
                                ]
                              }
                            },
                            {
                              "type": "required-validator",
                              "name": "StatusIdRequiredValidator",
                              "component": "StatusId",
                              "text": "StatusId is required",
                              "style": {
                                "position": "absolute"
                              },
                              "defaultValue": "0"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "style": {
                        "marginBottom": "1rem"
                      },
                      "components": [
                        {
                          "type": "col",
                          "class": "col-md-3",
                          "components": [
                            {
                              "type": "label",
                              "text": "Close Date",
                              "component": "CloseDate",
                              "name": "CloseDateLabel",
                              "style": {
                                "width": "100%"
                              }
                            }
                          ]
                        },
                        {
                          "type": "col",
                          "class": "col-md-9",
                          "components": [
                            {
                              "valueType": "DateTime",
                              "dateFormat": "dd/MM//yyyy",
                              "type": "datepicker",
                              "name": "CloseDate",
                              "style": {
                                "display": "block",
                                "width": "100%"
                              },
                              "value": "${opportunity.CloseDate}"
                            },
                            {
                              "type": "required-validator",
                              "name": "CloseDateRequiredValidator",
                              "component": "CloseDate",
                              "text": "CloseDate is required",
                              "style": {
                                "position": "absolute"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "style": {
                        "marginBottom": "1rem"
                      },
                      "components": [
                        {
                          "type": "col",
                          "class": "col-md-3",
                          "components": [
                            {
                              "type": "label",
                              "text": "Name",
                              "component": "Name",
                              "name": "NameLabel",
                              "style": {
                                "width": "100%"
                              }
                            }
                          ]
                        },
                        {
                          "type": "col",
                          "class": "col-md-9",
                          "components": [
                            {
                              "valueType": "string",
                              "maxLength": 256,
                              "type": "textbox",
                              "name": "Name",
                              "style": {
                                "display": "block",
                                "width": "100%"
                              },
                              "value": "${opportunity.Name}"
                            },
                            {
                              "type": "required-validator",
                              "name": "NameRequiredValidator",
                              "component": "Name",
                              "text": "Name is required",
                              "style": {
                                "position": "absolute"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "components": [
                        {
                          "type": "col",
                          "class": "col offset-sm-3",
                          "components": [
                            {
                              "type": "button",
                              "buttonType": "submit",
                              "icon": "save",
                              "text": "Save",
                              "buttonStyle": "primary"
                            },
                            {
                              "type": "button",
                              "buttonStyle": "light",
                              "style": {
                                "marginLeft": "1rem"
                              },
                              "text": "Cancel",
                              "events": {
                                "click": [
                                  {
                                    "type": "close-popup"
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "events": {
                    "submit": [
                      {
                        "error": [
                          {
                            "detail": "Unable to update Opportunity",
                            "severity": "error",
                            "summary": "Error",
                            "type": "notify"
                          },
                          {
                            "name": "hasChanges",
                            "type": "set",
                            "value": "result.Message.Contains(\"412\")",
                            "valueType": "bool"
                          },
                          {
                            "name": "canEdit",
                            "type": "set",
                            "condition": "!result.Message.Contains(\"412\")",
                            "value": "false",
                            "valueType": "bool"
                          }
                        ],
                        "name": "CRM.updateOpportunity",
                        "parameters": [
                          {
                            "name": "Id",
                            "value": "${parameters.Id}"
                          },
                          {
                            "name": "Opportunity",
                            "value": "${opportunity}"
                          }
                        ],
                        "then": [
                          {
                            "type": "close-popup",
                            "result": "${opportunity}",
                            "condition": "result.StatusCode != System.Net.HttpStatusCode.PreconditionFailed"
                          },
                          {
                            "name": "hasChanges",
                            "type": "set",
                            "value": "result.StatusCode == System.Net.HttpStatusCode.PreconditionFailed",
                            "valueType": "bool"
                          }
                        ],
                        "type": "invoke"
                      }
                    ]
                  },
                  "itemType": "BlazorCrmWasm.Models.Crm.Opportunity",
                  "data": "${opportunity}",
                  "visible": "${opportunity != null && canEdit}"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "events": {
    "load": [
      {
        "name": "hasChanges",
        "type": "set",
        "value": "false",
        "valueType": "bool"
      },
      {
        "name": "canEdit",
        "type": "set",
        "value": "true",
        "valueType": "bool"
      },
      {
        "name": "CRM.getOpportunityById",
        "parameters": [
          {
            "name": "Id",
            "value": "${parameters.Id}"
          }
        ],
        "then": [
          {
            "name": "opportunity",
            "type": "set",
            "value": "${result}",
            "valueType": "BlazorCrmWasm.Models.Crm.Opportunity"
          },
          {
            "name": "canEdit",
            "type": "set",
            "value": "result != null",
            "valueType": "bool"
          },
          {
            "name": "CRM.getContactById",
            "parameters": [
              {
                "name": "Id",
                "value": "${this.opportunity.ContactId}"
              }
            ],
            "then": [
              {
                "name": "getByContactsForContactIdResult",
                "type": "set",
                "value": "${result}",
                "valueType": "BlazorCrmWasm.Models.Crm.Contact"
              }
            ],
            "condition": "this.opportunity.ContactId != null",
            "type": "invoke"
          },
          {
            "name": "CRM.getOpportunityStatusById",
            "parameters": [
              {
                "name": "Id",
                "value": "${this.opportunity.StatusId}"
              }
            ],
            "then": [
              {
                "name": "getByOpportunityStatusesForStatusIdResult",
                "type": "set",
                "value": "${result}",
                "valueType": "BlazorCrmWasm.Models.Crm.OpportunityStatus"
              }
            ],
            "condition": "this.opportunity.StatusId != null",
            "type": "invoke"
          }
        ],
        "error": [],
        "type": "invoke"
      }
    ]
  },
  "name": "Edit Opportunity",
  "layout": "Main"
}