{
  "components": [
    {
      "type": "content",
      "container": "main",
      "components": [
        {
          "type": "row",
          "components": [
            {
              "type": "col",
              "class": "col-md-12",
              "components": [
                {
                  "type": "template-form",
                  "name": "form0",
                  "components": [
                    {
                      "type": "row",
                      "style": {
                        "marginBottom": "1rem"
                      },
                      "components": [
                        {
                          "type": "col",
                          "class": "col-md-3",
                          "components": [
                            {
                              "type": "label",
                              "text": "Start Date",
                              "component": "StartDate",
                              "name": "StartDateLabel",
                              "style": {
                                "width": "100%"
                              }
                            }
                          ]
                        },
                        {
                          "type": "col",
                          "class": "col-md-9",
                          "components": [
                            {
                              "valueType": "DateTime?",
                              "dateFormat": "dd/MM//yyyy",
                              "type": "datepicker",
                              "name": "StartDate",
                              "style": {
                                "width": "100%"
                              },
                              "value": "${schedulerappointment.StartDate}"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "style": {
                        "marginBottom": "1rem"
                      },
                      "components": [
                        {
                          "type": "col",
                          "class": "col-md-3",
                          "components": [
                            {
                              "type": "label",
                              "text": "End Date",
                              "component": "EndDate",
                              "name": "EndDateLabel",
                              "style": {
                                "width": "100%"
                              }
                            }
                          ]
                        },
                        {
                          "type": "col",
                          "class": "col-md-9",
                          "components": [
                            {
                              "valueType": "DateTime?",
                              "dateFormat": "dd/MM//yyyy",
                              "type": "datepicker",
                              "name": "EndDate",
                              "style": {
                                "width": "100%"
                              },
                              "value": "${schedulerappointment.EndDate}"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "style": {
                        "marginBottom": "1rem"
                      },
                      "components": [
                        {
                          "type": "col",
                          "class": "col-md-3",
                          "components": [
                            {
                              "type": "label",
                              "text": "Text Desc",
                              "component": "TextDesc",
                              "name": "TextDescLabel",
                              "style": {
                                "width": "100%"
                              }
                            }
                          ]
                        },
                        {
                          "type": "col",
                          "class": "col-md-9",
                          "components": [
                            {
                              "valueType": "string",
                              "type": "textbox",
                              "name": "TextDesc",
                              "style": {
                                "width": "100%"
                              },
                              "value": "${schedulerappointment.TextDesc}"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "components": [
                        {
                          "type": "col",
                          "class": "col offset-sm-3",
                          "components": [
                            {
                              "type": "button",
                              "buttonType": "submit",
                              "icon": "save",
                              "text": "Save",
                              "buttonStyle": "primary"
                            },
                            {
                              "type": "button",
                              "buttonStyle": "light",
                              "style": {
                                "marginLeft": "1rem"
                              },
                              "text": "Cancel",
                              "events": {
                                "click": [
                                  {
                                    "type": "close-popup"
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "events": {
                    "submit": [
                      {
                        "error": [
                          {
                            "detail": "Unable to create new SchedulerAppointment!",
                            "severity": "error",
                            "summary": "Error",
                            "type": "notify"
                          }
                        ],
                        "name": "CRM.createSchedulerAppointment",
                        "parameters": [
                          {
                            "name": "SchedulerAppointment",
                            "value": "${schedulerappointment}"
                          }
                        ],
                        "then": [
                          {
                            "type": "close-popup",
                            "result": "${schedulerappointment}"
                          }
                        ],
                        "type": "invoke"
                      }
                    ]
                  },
                  "data": "${schedulerappointment}",
                  "visible": "${schedulerappointment != null}",
                  "itemType": "BlazorCrmWasm.Models.Crm.SchedulerAppointment"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "events": {
    "load": [
      {
        "name": "schedulerappointment",
        "type": "set",
        "value": "new BlazorCrmWasm.Models.Crm.SchedulerAppointment(){}",
        "valueType": "BlazorCrmWasm.Models.Crm.SchedulerAppointment"
      }
    ]
  },
  "name": "Add Scheduler Appointment",
  "layout": "Main"
}