@page "/edit-tasklist/{Id}"
@layout MainLayout
@inherits BlazorCrmWasm.Pages.EditTasklistComponent

@using Radzen
@using Radzen.Blazor
@using BlazorCrmWasm.Models.Crm
<PageTitle>Edit Tasklist</PageTitle>
<RadzenContent Container="main">
  <ChildContent>
    <div  class="row">
      <div class="col-md-9">
        <RadzenLabel style="font-weight: bold" Text="Item no longer available." Visible="@(!canEdit)">
        </RadzenLabel>
      </div>
      <div class="col-md-3">
        <RadzenButton ButtonStyle="ButtonStyle.Secondary" style="margin-bottom: 20px" Text="Close" Visible="@(!canEdit)" Click="@CloseButtonClick">
        </RadzenButton>
      </div>
    </div>
    <div  class="row">
      <div class="col-md-9">
        <RadzenLabel style="font-weight: bold" Text="Another user has made conflicting changes to one or more of the fields you have modified. Please reload." Visible="@hasChanges">
        </RadzenLabel>
      </div>
      <div class="col-md-3">
        <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="autorenew" style="margin-bottom: 20px" Text="Reload" Visible="@hasChanges" Click="@Button0Click">
        </RadzenButton>
      </div>
    </div>
    <div class="row">
      <div class="col-md-12">
        <RadzenTemplateForm TItem="BlazorCrmWasm.Models.Crm.Tasklist" Data="@tasklist" Visible="@(tasklist != null && canEdit)" Submit="@Form0Submit">
          <ChildContent>
            <div style="margin-bottom: 1rem" class="row">
              <div class="col-md-3">
                <RadzenLabel Text="Title" Component="Title" style="width: 100%">
                </RadzenLabel>
              </div>
              <div class="col-md-9">
                <RadzenTextBox MaxLength="256" style="width: 100%" @bind-Value="@(tasklist.Title)" Name="Title">
                </RadzenTextBox>
              </div>
            </div>
            <div style="margin-bottom: 1rem" class="row">
              <div class="col-md-3">
                <RadzenLabel Text="Opportunity" Component="OpportunityId" style="width: 100%">
                </RadzenLabel>
              </div>
              <div class="col-md-9">
                <RadzenDropDownDataGrid Data="@getOpportunitiesForOpportunityIdResult" TextProperty="UserId" ValueProperty="Id" Placeholder="Choose Opportunity" ShowSearch="false" Count="@getOpportunitiesForOpportunityIdCount" @bind-Value="@(tasklist.OpportunityId)" style="display: block; width: 100%" SelectedValue="@getByOpportunitiesForOpportunityIdResult" Name="OpportunityId" LoadData="@OpportunityIdLoadData">
                </RadzenDropDownDataGrid>
                <RadzenRequiredValidator Component="OpportunityId" Text="OpportunityId is required" style="position: absolute" DefaultValue="0">
                </RadzenRequiredValidator>
              </div>
            </div>
            <div style="margin-bottom: 1rem" class="row">
              <div class="col-md-3">
                <RadzenLabel Text="Due Date" Component="DueDate" style="width: 100%">
                </RadzenLabel>
              </div>
              <div class="col-md-9">
                <RadzenDatePicker DateFormat="dd/MM//yyyy" style="display: block; width: 100%" @bind-Value="@(tasklist.DueDate)" Name="DueDate">
                </RadzenDatePicker>
                <RadzenRequiredValidator Component="DueDate" Text="DueDate is required" style="position: absolute">
                </RadzenRequiredValidator>
              </div>
            </div>
            <div style="margin-bottom: 1rem" class="row">
              <div class="col-md-3">
                <RadzenLabel Text="Task Type" Component="TypeId" style="width: 100%">
                </RadzenLabel>
              </div>
              <div class="col-md-9">
                <RadzenDropDownDataGrid Data="@getTaskTypesForTypeIdResult" TextProperty="Name" ValueProperty="Id" Placeholder="Choose TaskType" ShowSearch="false" Count="@getTaskTypesForTypeIdCount" @bind-Value="@(tasklist.TypeId)" style="display: block; width: 100%" SelectedValue="@getByTaskTypesForTypeIdResult" Name="TypeId" LoadData="@TypeIdLoadData">
                </RadzenDropDownDataGrid>
                <RadzenRequiredValidator Component="TypeId" Text="TypeId is required" style="position: absolute" DefaultValue="0">
                </RadzenRequiredValidator>
              </div>
            </div>
            <div style="margin-bottom: 1rem" class="row">
              <div class="col-md-3">
                <RadzenLabel Text="Task Status" Component="StatusId" style="width: 100%">
                </RadzenLabel>
              </div>
              <div class="col-md-9">
                <RadzenDropDownDataGrid Data="@getTaskStatusesForStatusIdResult" TextProperty="Name" ValueProperty="Id" Placeholder="Choose TaskStatus" ShowSearch="false" Count="@getTaskStatusesForStatusIdCount" @bind-Value="@(tasklist.StatusId)" style="width: 100%" SelectedValue="@getByTaskStatusesForStatusIdResult" Name="StatusId" LoadData="@StatusIdLoadData">
                </RadzenDropDownDataGrid>
              </div>
            </div>
            <div class="row">
              <div class="col offset-sm-3">
                <RadzenButton ButtonType="ButtonType.Submit" Icon="save" Text="Save" ButtonStyle="ButtonStyle.Primary">
                </RadzenButton>
                <RadzenButton ButtonStyle="ButtonStyle.Light" style="margin-left: 1rem" Text="Cancel" Click="@Button4Click">
                </RadzenButton>
              </div>
            </div>
          </ChildContent>
        </RadzenTemplateForm>
      </div>
    </div>
  </ChildContent>
</RadzenContent>
